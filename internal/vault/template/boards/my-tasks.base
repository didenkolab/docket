# Change the assignee below to your own handle.
filters:
  and:
    - file.inFolder("tasks")
    - 'note.assignee == "agent/claude"'
    - 'note.status_category != "done"'
views:
  - type: table
    name: My tasks
    order:
      - file.name
      - note.title
      - note.status
      - note.priority
      - note.updated
